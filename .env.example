# ========================================================
# ENTERPRISE AI PLATFORM - ENVIRONMENT CONFIGURATION
# ========================================================

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication
SECRET_KEY=enter_your_jwt_secret_key_here_min_32_characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database Configuration (PostgreSQL + pgvector)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_ai_db
DATABASE_URL=postgresql://postgres:postgres_password_here@localhost:5432/enterprise_ai_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# GenAI & LLM Services
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-1.5-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG & Vector Search Configuration
SIMILARITY_THRESHOLD=0.72
TOP_K_CHUNKS=5
RERANKER_ENABLED=true
HYBRID_SEARCH_ALPHA=0.65

# ML & Tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MODEL_REGISTRY_PATH=./ml/models

# Workflow & Notifications
NOTIFICATION_EMAIL_ENABLED=false
SMTP_SERVER=smtp.company.com
SMTP_PORT=587
SMTP_USER=no-reply@enterprise.ai
SMTP_PASSWORD=smtp_password_here
ADMIN_EMAIL=admin@enterprise.ai

# Guardrails
ENABLE_GUARDRAILS=true
STRICT_SQL_VALIDATION=true
MAX_EXECUTION_TIME_SECONDS=30
